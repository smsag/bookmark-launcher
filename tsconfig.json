{
	"compilerOptions": {
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES6",
		"allowSyntheticDefaultImports": true,
		"importHelpers": true,
		"lib": [
			"ES6",
			"DOM"
		],
		"moduleResolution": "bundler",
		"strict": true,
		"resolveJsonModule": true
	},
	"include": [
		"**/*.ts"
	]
}
